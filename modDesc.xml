    <sourceFile filename="scripts/TrackPosition.lua" />
    <sourceFile filename="scripts/TrackRenderer.lua" />
    <sourceFile filename="scripts/ABPreviewRenderer.lua" />
    <sourceFile filename="scripts/SteeringDiagnostics.lua" />
    <sourceFile filename="scripts/SteeringController.lua" />
    <sourceFile filename="scripts/GPSMenu.lua" />
    <sourceFile filename="scripts/GPSMenuSymbols.lua" />
        <sourceFile filename="scripts/GPSMenuPage1.lua" />
