    </actionBinding>
    <actionBinding action="GPS_FIELD_ROTATE_90">
      <binding device="KB_MOUSE_DEFAULT" input="KEY_lalt KEY_r" />
    </actionBinding>
    <actionBinding action="GPS_FIELD_ROTATE_EAST">
      <binding device="KB_MOUSE_DEFAULT" input="KEY_lalt KEY_j" />
    </actionBinding>
    <actionBinding action="GPS_FIELD_ROTATE_WEST">
