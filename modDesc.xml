<?xml version="1.0" encoding="utf-8"?>
<modDesc descVersion="114">
  <author>PatchPunk</author>
  <version>0.9.9.60</version>
  <title><en>TerraLine GPS</en><de>TerraLine GPS</de></title>
  <iconFilename>icon_terraline.dds</iconFilename>
  <description><en>Mod for Farming Simulator 25. Free PC-only A/B GPS guidance with named and saved courses, steering assistance, adjustable line visualization, manual lane shifting and implement-offset diagnostics. Public PC beta: server-based farm courses; dedicated-server tests with one client passed. Simultaneous multiplayer players not yet tested.</en><de>A/B-GPS-Spurfuehrung fuer PC mit gespeicherten Kursen, Lenkassistent, Linien-Optik, manuellem Spurversatz und Geraeteversatz-Diagnose. Kostenlose PC-Beta von PatchPunk: A/B-GPS, Lenkhilfe bis 30 km/h, Hofkurse, Fahrzeugshop-GPS (+10.000 EUR), Nachruestung und Tacho-Status. Dedicated mit einem Client getestet; 2-Spieler-Multiplayer noch ungetestet. Mod fuer Farming Simulator 25.</de></description>
  <multiplayer supported="true" />
  <l10n>
    <text name="input_GPS_FIELD_POWER_TOGGLE"><de>TerraLine GPS Hauptschalter ein/aus</de><en>Toggle TerraLine GPS power</en></text>
    <text name="input_GPS_FIELD_ASSIST_TOGGLE"><de>GPS Spurhaltung ein/aus</de><en>Toggle GPS steering assist</en></text>
    <text name="input_GPS_FIELD_AB_MARK"><de>GPS Punkt A/B setzen</de><en>Set GPS A/B point</en></text>
    <text name="input_GPS_FIELD_SHIFT_RIGHT"><de>GPS-Spur samt Arbeitsgrenzen rechts verschieben</de><en>Shift GPS A/B line right</en></text>
    <text name="input_GPS_FIELD_SHIFT_LEFT"><de>GPS-Spur samt Arbeitsgrenzen links verschieben</de><en>Shift GPS A/B line left</en></text>
    <text name="input_GPS_FIELD_MENU_TOGGLE"><de>GPS Einstellungsmenue oeffnen/schliessen</de><en>Open/close GPS settings menu</en></text>
    <text name="input_GPS_FIELD_ROTATE_MODE"><de>TerraLine GPS Spurwinkelmodus umschalten (Rechts-Alt + W)</de><en>Toggle fine angle mode (Right Alt + W)</en></text>
    <text name="input_GPS_FIELD_ROTATE_90"><de>TerraLine GPS Spur 90 Grad drehen</de><en>TerraLine GPS rotate lane 90 degrees</en></text>
    <text name="input_GPS_FIELD_ROTATE_EAST"><de>TerraLine GPS Spurwinkel im Drehmodus um 0,1 Grad erhoehen</de><en>Fine rotate course clockwise by 0.1 degree when mode is on</en></text>
    <text name="input_GPS_FIELD_ROTATE_WEST"><de>TerraLine GPS Spurwinkel im Drehmodus um 0,1 Grad verringern</de><en>Fine rotate course anticlockwise by 0.1 degree when mode is on</en></text>
  </l10n>
  <actions>
    <action name="GPS_FIELD_POWER_TOGGLE" category="VEHICLE" />
    <action name="GPS_FIELD_ASSIST_TOGGLE" category="VEHICLE" />
    <action name="GPS_FIELD_AB_MARK" category="VEHICLE" />
    <action name="GPS_FIELD_SHIFT_RIGHT" category="VEHICLE" />
    <action name="GPS_FIELD_SHIFT_LEFT" category="VEHICLE" />
